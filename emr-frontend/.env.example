# Leave this unset for local dev — vite.config.js proxies /api requests
# to http://localhost:8080 automatically, so the app works out of the box
# against a locally running Spring Boot backend.
#
# For a production build pointed at a deployed backend (e.g. Render.com),
# set this to the full backend URL with no trailing slash:
# VITE_API_BASE_URL=https://records-emr.onrender.com
VITE_API_BASE_URL=
